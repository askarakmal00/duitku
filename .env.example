# PostgreSQL Database Configuration (Server VPS)
# Hubungkan ke PostgreSQL di host VPS melalui host.docker.internal:5432
DATABASE_URL=postgresql://duitku_user:password_rahasia@host.docker.internal:5432/duitku_db?sslmode=disable

# (Opsional) Jika masih ingin memakai Supabase cloud, isi variabel berikut:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
