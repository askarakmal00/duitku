# Telegram Bot & AI Gemini (Chat-to-Transaction)
# 1. Buat bot via @BotFather di Telegram, copy HTTP API Token-nya
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# 2. Dapatkan API Key gratis di https://aistudio.google.com
GEMINI_API_KEY=AIzaSy...

# 3. (Opsional) Batasi hanya ID Telegram tertentu yang boleh catat transaksi (ketik /id di bot)
TELEGRAM_ALLOWED_USERS=

# PostgreSQL Database Configuration (Server VPS)
# Hubungkan ke PostgreSQL di host VPS melalui host.docker.internal:5432
DATABASE_URL=postgresql://duitku_user:password_rahasia@host.docker.internal:5432/duitku_db?sslmode=disable
